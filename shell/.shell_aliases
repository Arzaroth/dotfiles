# `command -v` prints a bare name for functions, aliases and builtins, which is
# not a path, so testing its output with -x misses them.
_have() {
    command -v "$1" >/dev/null 2>&1
}

if _have lsd; then
    alias ls="lsd"
    alias ll="lsd -l"
    alias la="lsd -a"
    alias l="lsd -F"
elif _have exa; then
    alias ls="exa"
    alias ll="exa -lgh"
    alias la="exa -lgha"
    alias l="exa -GF"
else
    alias ls='ls --color=auto --ignore="*.pyc"'
    alias ll='ls -lF'
    alias la='ls -lA'
    alias l='ls -CF'
fi

if _have bat; then
    alias cat='bat --paging=never'
    alias less='bat --paging=always'
else
    alias less='less -R'
fi

# emacs should never start in a window
alias emacs="te"
alias ne="te"

alias j='jobs'

# rsync-backed copy. Deliberately not aliased over cp: rsync treats trailing
# slashes differently, takes different flags, and would silently change the
# meaning of every existing cp invocation and script habit.
alias rcp='rsync -azvtP'

# docker images analysis
alias dive="docker run -ti --rm  -v /var/run/docker.sock:/var/run/docker.sock docker.io/wagoodman/dive"

unset -f _have
